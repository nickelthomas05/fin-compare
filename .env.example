# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEC EDGAR requires a descriptive User-Agent with contact email
SEC_USER_AGENT="FinCompare student-project you@example.com"

# Finnhub (optional) — https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — use a sandbox; a restricted key (rk_test_...) is preferred over sk_test_...
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard endpoint
STRIPE_WEBHOOK_SECRET=
# Printed by `npm run stripe:setup`
STRIPE_PORTAL_CONFIGURATION_ID=
# Only set to "true" after a head office address and at least one tax registration exist (Dashboard > Tax)
STRIPE_AUTOMATIC_TAX=false
# Product tax code applied by `npm run stripe:setup` (pick from https://docs.stripe.com/tax/tax-codes)
STRIPE_TAX_CODE=
